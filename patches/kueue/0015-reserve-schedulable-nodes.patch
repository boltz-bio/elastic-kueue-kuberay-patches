+	for _, size := range []int{58, 59, 63} {
+		t.Run(fmt.Sprintf("workload length %d", size), func(t *testing.T) {
+			wl := utiltestingapi.MakeWorkload(strings.Repeat("a", size), "example").UID("workload-uid").Obj()
+			podSet := strings.Repeat("b", 63)
+			claim := (&nodeClaimTemplate{}).nodeClaim(wl, "0123456789", podSet+"-0", 1, nil, nil)
+			labels := claim.GetLabels()
+			labels[constants.PodSetLabel] = podSet
+			labels["provider.example.com/claim-name"] = claim.GetName()
+			meta := metav1.ObjectMeta{Name: claim.GetName(), Labels: labels}
+			if errors := apivalidation.ValidateObjectMeta(&meta, false, apivalidation.NameIsDNSSubdomain, field.NewPath("metadata")); len(errors) != 0 {
+				t.Fatalf("generated metadata violates API validation: %v", errors)
+			}
+			if size == 58 && labels[GangIDLabelKey] != "gang-"+wl.Name {
+				t.Error("changed valid existing gang ID")
+			}
+		})
+	}
+}
