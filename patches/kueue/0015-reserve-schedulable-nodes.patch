+func TestNodeClaimMandatoryAffinityBranches(t *testing.T) {
+	for name, tc := range map[string]struct {
+		terms []corev1.NodeSelectorTerm
+		want  string
+	}{
+		"skip incompatible first branch": {terms: []corev1.NodeSelectorTerm{
+			placementTerm(corev1.LabelArchStable, corev1.NodeSelectorOpIn, "arm64"), placementTerm("gpu-class", corev1.NodeSelectorOpIn, "l4"),
+		}, want: "l4"},
+		"choose first compatible alternative": {terms: []corev1.NodeSelectorTerm{
+			placementTerm("gpu-class", corev1.NodeSelectorOpIn, "l4"), placementTerm("gpu-class", corev1.NodeSelectorOpIn, "l40s"),
+		}, want: "l4"},
+		"skip unrepresentable alternative": {terms: []corev1.NodeSelectorTerm{
+			{MatchFields: []corev1.NodeSelectorRequirement{{Key: "metadata.name", Operator: corev1.NodeSelectorOpIn, Values: []string{"existing-node"}}}},
+			placementTerm("gpu-class", corev1.NodeSelectorOpIn, "l40s"),
+		}, want: "l40s"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ps := utiltestingapi.MakePodSet("workers", 1).Request(corev1.ResourceCPU, "1").Obj()
+			ps.Template.Spec.NodeSelector = map[string]string{corev1.LabelArchStable: "amd64"}
+			ps.Template.Spec.Affinity = mandatoryAffinity(tc.terms...)
+			f := newFixture(t, podSetWorkload(ps), nil)
+			f.reconcile()
+			claims := f.claims()
+			if len(claims) != 1 {
+				t.Fatalf("claims = %d, want 1", len(claims))
+			}
+			raw, _, _ := unstructured.NestedSlice(claims[0].Object, "spec", "requirements")
+			decoded := struct {
+				Requirements []corev1.NodeSelectorRequirement `json:"requirements"`
+			}{}
+			if err := runtime.DefaultUnstructuredConverter.FromUnstructured(map[string]any{"requirements": raw}, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			selector, err := nodeaffinity.NewNodeSelector(&corev1.NodeSelector{NodeSelectorTerms: []corev1.NodeSelectorTerm{{MatchExpressions: decoded.Requirements}}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, class := range []string{"l4", "l40s", "other"} {
+				node := &corev1.Node{Labels: map[string]string{
+					corev1.LabelArchStable: "amd64", "gpu-class": class, NodePoolLabelKey: "pool-a", "karpenter.sh/capacity-type": "on-demand",
+				}}
+				matches := selector.Match(node)
+				if matches != (class == tc.want) {
+					t.Errorf("claim accepts class %s = %v, want only %s", class, matches, tc.want)
+				}
+				original, err := nodeaffinity.GetRequiredNodeAffinity(&corev1.Pod{Spec: ps.Template.Spec}).Match(node)
+				if err != nil || (matches && !original) {
+					t.Errorf("claim broadened original affinity for %s: matches=%v original=%v error=%v", class, matches, original, err)
+				}
+			}
+		})
+	}
+}
