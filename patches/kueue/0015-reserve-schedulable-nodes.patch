+func TestNodeClaimNamesFitProviderLabels(t *testing.T) {
+	for name, tc := range map[string]struct {
+		workload  string
+		suffix    string
+		unchanged bool
+	}{
+		"exactly 63 bytes":          {workload: strings.Repeat("a", 45), suffix: "main-0", unchanged: true},
+		"exactly 64 bytes":          {workload: strings.Repeat("a", 46), suffix: "main-0"},
+		"long workload and pod set": {workload: strings.Repeat("a", 58), suffix: strings.Repeat("b", 63) + "-99"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			wl := utiltestingapi.MakeWorkload(tc.workload, "example").UID("workload-uid").Obj()
+			claim := (&nodeClaimTemplate{}).nodeClaim(wl, "0123456789", tc.suffix, 1, nil, nil)
+			got := claim.GetName()
+			if errors := validation.IsValidLabelValue(got); len(errors) != 0 {
+				t.Fatalf("name cannot be used as a label: %v", errors)
+			}
+			legacy := legacyNodeClaimName(wl.Name, "0123456789", tc.suffix)
+			if (got == legacy) != tc.unchanged {
+				t.Errorf("name=%q legacy=%q unchanged=%t", got, legacy, tc.unchanged)
+			}
+			if !tc.unchanged {
+				meta := metav1.ObjectMeta{Name: legacy}
+				if errors := apivalidation.ValidateObjectMeta(&meta, false, apivalidation.NameIsDNSSubdomain, field.NewPath("metadata")); len(errors) != 0 {
+					t.Fatalf("legacy name itself should be valid: %v", errors)
+				}
+				meta.Labels = map[string]string{"provider.example.com/claim-name": legacy}
+				if errors := apivalidation.ValidateObjectMeta(&meta, false, apivalidation.NameIsDNSSubdomain, field.NewPath("metadata")); len(errors) == 0 {
+					t.Fatal("legacy provider label unexpectedly passed API validation")
+				}
+			}
+			labels := claim.GetLabels()
+			labels["provider.example.com/claim-name"] = got
+			meta := metav1.ObjectMeta{Name: got, Labels: labels}
+			if errors := apivalidation.ValidateObjectMeta(&meta, false, apivalidation.NameIsDNSSubdomain, field.NewPath("metadata")); len(errors) != 0 {
+				t.Fatalf("provider metadata violates API validation: %v", errors)
+			}
+		})
+	}
+}
