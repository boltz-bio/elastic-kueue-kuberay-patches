+func TestProvisionedClaimsRejectIncompleteOrUnrelatedCapacity(t *testing.T) {
+	for name, mutate := range map[string]func([]unstructured.Unstructured) []unstructured.Unstructured{
+		"unchanged":    func(c []unstructured.Unstructured) []unstructured.Unstructured { return c },
+		"missing tail": func(c []unstructured.Unstructured) []unstructured.Unstructured { return c[:1] },
+		"ordinal gap":  func(c []unstructured.Unstructured) []unstructured.Unstructured { c[1].SetName("unexpected"); return c },
+		"zero count": func(c []unstructured.Unstructured) []unstructured.Unstructured {
+			c[0].SetAnnotations(map[string]string{PodsAnnotation: "0"})
+			return c
+		},
+		"invalid count": func(c []unstructured.Unstructured) []unstructured.Unstructured {
+			c[0].SetAnnotations(map[string]string{PodsAnnotation: "invalid"})
+			return c
+		},
+		"excess count": func(c []unstructured.Unstructured) []unstructured.Unstructured {
+			c[0].SetAnnotations(map[string]string{PodsAnnotation: "3"})
+			return c
+		},
+		"duplicate canonical and legacy ordinal": func(c []unstructured.Unstructured) []unstructured.Unstructured {
+			duplicate := *c[0].DeepCopy()
+			duplicate.SetName(legacyNodeClaimName(c[0].GetLabels()[WorkloadLabelKey], c[0].GetLabels()[AttemptLabelKey], fmt.Sprintf("%s-0", kueue.DefaultPodSetName)))
+			duplicate.SetAnnotations(map[string]string{PodsAnnotation: "1"})
+			c[0].SetAnnotations(map[string]string{PodsAnnotation: "1"})
+			return append(c, duplicate)
+		},
+		"wrong pool": func(c []unstructured.Unstructured) []unstructured.Unstructured {
+			l := c[0].GetLabels()
+			l[NodePoolLabelKey] = "different"
+			c[0].SetLabels(l)
+			return c
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			wl := reservedWorkload("karpenter-a").Obj()
+			wl.Name = strings.Repeat("a", 46)
+			attempt := attemptID(wl, reservedAt)
+			claims := make([]unstructured.Unstructured, 2)
+			for i := range claims {
+				suffix := fmt.Sprintf("%s-%d", kueue.DefaultPodSetName, i)
+				claims[i].SetName(nodeClaimName(wl, attempt, suffix))
+				claims[i].SetLabels(
+					map[string]string{
+						ManagedLabelKey:           "kueue",
+						WorkloadLabelKey:          wl.Name,
+						WorkloadNamespaceLabelKey: wl.Namespace,
+						AttemptLabelKey:           attempt,
+						constants.PodSetLabel:     string(kueue.DefaultPodSetName),
+						NodePoolLabelKey:          "pool-a",
+					},
+				)
+				claims[i].SetAnnotations(map[string]string{PodsAnnotation: "2"})
+			}
+			got, problem := provisionedPodSetClaims(wl, attempt, kueue.DefaultPodSetName, 4, map[string]string{NodePoolLabelKey: "pool-a"}, mutate(claims))
+			if name == "unchanged" {
+				if problem != "" || len(got) != 2 {
+					t.Fatalf("claims=%d problem=%s", len(got), problem)
+				}
+			} else if problem == "" {
+				t.Fatalf("invalid existing capacity accepted: %v", got)
+			}
+		})
+	}
+}
