+// Project mandatory Pod placement into NodeClaim requirements without broadening the selected NodePool or flavors.
+package karpenter
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+)
+
+// podPlacementRequirements chooses one compatible required-affinity term for a new node.
+// NodeClaim requirements are a conjunction; combining different OR terms would change Pod semantics.
+func podPlacementRequirements(tmpl *nodeClaimTemplate, pod *corev1.PodSpec) ([]any, error) {
+	if pod.NodeName != "" {
+		return nil, errors.New("nodeName cannot select a newly provisioned node")
+	}
+	base := make([]any, 0, len(tmpl.requirements)+len(pod.NodeSelector))
+	for _, req := range tmpl.requirements {
+		base = append(base, runtime.DeepCopyJSONValue(req))
+	}
+	keys := make([]string, 0, len(pod.NodeSelector))
+	for key := range pod.NodeSelector {
+		keys = append(keys, key)
+	}
+	slices.Sort(keys)
+	for _, key := range keys {
+		base = append(base, requirement(key, pod.NodeSelector[key]))
+	}
+	decoded := struct {
+		Requirements []corev1.NodeSelectorRequirement `json:"requirements"`
+	}{}
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(map[string]any{"requirements": base}, &decoded); err != nil {
+		return nil, fmt.Errorf("decoding node requirements: %w", err)
+	}
+	constraints := decoded.Requirements
+	for key, value := range tmpl.labels {
+		constraints = append(constraints, corev1.NodeSelectorRequirement{Key: key, Operator: corev1.NodeSelectorOpIn, Values: []string{value}})
+	}
+	compatible, err := selectorRequirementsCompatible(constraints)
+	if err != nil {
+		return nil, fmt.Errorf("validating node requirements: %w", err)
+	}
+	if !compatible {
+		return nil, errors.New("node selectors conflict with the NodePool or assigned flavors")
+	}
+	if pod.Affinity == nil || pod.Affinity.NodeAffinity == nil || pod.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution == nil {
+		return base, nil
+	}
+	unsupported := false
+	for _, term := range pod.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms {
+		if len(term.MatchFields) > 0 {
+			unsupported = true
+			continue
+		}
+		if len(term.MatchExpressions) == 0 {
+			continue
+		}
+		candidate := append(append([]corev1.NodeSelectorRequirement{}, constraints...), term.MatchExpressions...)
+		compatible, err := selectorRequirementsCompatible(candidate)
+		if err != nil {
+			return nil, fmt.Errorf("validating required node affinity: %w", err)
+		}
+		if !compatible {
+			continue
+		}
+		for i := range term.MatchExpressions {
+			req, err := runtime.DefaultUnstructuredConverter.ToUnstructured(&term.MatchExpressions[i])
+			if err != nil {
+				return nil, fmt.Errorf("encoding required node affinity: %w", err)
+			}
+			base = append(base, req)
+		}
+		return base, nil
+	}
+	if unsupported {
+		return nil, errors.New("no compatible required-affinity term can be expressed as NodeClaim label requirements; node fields are unsupported")
+	}
+	return nil, errors.New("no required node-affinity term matches the NodePool, assigned flavors, and node selectors")
+}
