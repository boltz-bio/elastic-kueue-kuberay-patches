+func TestNodeClaimNamesHashTheFullIdentity(t *testing.T) {
+	base := utiltestingapi.MakeWorkload(strings.Repeat("a", 201)+"x", "example").UID("workload-uid").Obj()
+	claimName := func(wl *kueue.Workload, attempt, suffix string) string {
+		return (&nodeClaimTemplate{}).nodeClaim(wl, attempt, suffix, 1, nil, nil).GetName()
+	}
+	want := claimName(base, "0123456789", "workers-0")
+	if got := claimName(base.DeepCopy(), "0123456789", "workers-0"); got != want {
+		t.Fatalf("same identity produced %q then %q", want, got)
+	}
+	seen := map[string]string{want: "base"}
+	for name, mutate := range map[string]func(*kueue.Workload) (string, string){
+		"untruncated workload tail": func(wl *kueue.Workload) (string, string) {
+			wl.Name = strings.Repeat("a", 201) + "y"
+			return "0123456789", "workers-0"
+		},
+		"namespace":    func(wl *kueue.Workload) (string, string) { wl.Namespace = "another"; return "0123456789", "workers-0" },
+		"workload UID": func(wl *kueue.Workload) (string, string) { wl.UID = "another-uid"; return "0123456789", "workers-0" },
+		"attempt":      func(wl *kueue.Workload) (string, string) { return "9876543210", "workers-0" },
+		"pod set":      func(wl *kueue.Workload) (string, string) { return "0123456789", "another-0" },
+		"ordinal":      func(wl *kueue.Workload) (string, string) { return "0123456789", "workers-1" },
+	} {
+		wl := base.DeepCopy()
+		attempt, suffix := mutate(wl)
+		got := claimName(wl, attempt, suffix)
+		if previous, exists := seen[got]; exists {
+			t.Errorf("%s and %s produced the same name %q", name, previous, got)
+		}
+		seen[got] = name
+		if errors := validation.IsValidLabelValue(got); len(errors) != 0 {
+			t.Errorf("%s: %v", name, errors)
+		}
+	}
+}
