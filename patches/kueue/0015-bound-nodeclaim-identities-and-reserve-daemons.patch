+func TestAdoptsAlreadyProvisionedLegacyNodeClaim(t *testing.T) {
+	for name, mutate := range map[string]func(*unstructured.Unstructured, *kueue.Workload){
+		"matching registered claim": func(*unstructured.Unstructured, *kueue.Workload) {},
+		"unrelated claim name":      func(nc *unstructured.Unstructured, _ *kueue.Workload) { nc.SetName(nc.GetName() + "-other") },
+		"unrelated attempt": func(nc *unstructured.Unstructured, _ *kueue.Workload) {
+			labels := nc.GetLabels()
+			labels[AttemptLabelKey] = "another"
+			nc.SetLabels(labels)
+		},
+		"unrelated workload": func(nc *unstructured.Unstructured, _ *kueue.Workload) {
+			labels := nc.GetLabels()
+			labels[WorkloadLabelKey] = "another"
+			nc.SetLabels(labels)
+		},
+		"unrelated namespace": func(nc *unstructured.Unstructured, _ *kueue.Workload) {
+			labels := nc.GetLabels()
+			labels[WorkloadNamespaceLabelKey] = "another"
+			nc.SetLabels(labels)
+		},
+		"unrelated pod set": func(nc *unstructured.Unstructured, _ *kueue.Workload) {
+			labels := nc.GetLabels()
+			labels[constants.PodSetLabel] = "another"
+			nc.SetLabels(labels)
+		},
+		"unrelated pool": func(nc *unstructured.Unstructured, _ *kueue.Workload) {
+			labels := nc.GetLabels()
+			labels[NodePoolLabelKey] = "another"
+			nc.SetLabels(labels)
+		},
+		"not already provisioned": func(_ *unstructured.Unstructured, wl *kueue.Workload) {
+			delete(wl.Annotations, ProvisionedAttemptAnnotation)
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			wl := reservedWorkload("karpenter-a").Obj()
+			wl.Name = strings.Repeat("a", 46)
+			attempt := attemptID(wl, reservedAt)
+			wl.Annotations = map[string]string{ProvisionedAttemptAnnotation: attempt}
+			f := newFixture(t, wl, nil)
+			f.wlKey.Name = wl.Name
+			cfg, err := parseConfig(&kueue.AdmissionCheck{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected, problem, err := f.ctrl.desiredNodeClaims(f.ctx, wl, attempt, cfg, []string{"karpenter-a"}, nil)
+			if err != nil || problem != "" || len(expected) != 2 {
+				t.Fatalf("desired claims: %d %q %v", len(expected), problem, err)
+			}
+			legacyNames := map[string]bool{}
+			for i, claim := range expected {
+				claim.SetName(legacyNodeClaimName(wl.Name, attempt, fmt.Sprintf("%s-%d", kueue.DefaultPodSetName, i)))
+				legacyNames[claim.GetName()] = true
+				mutate(claim, wl)
+				if err := f.c.Create(f.ctx, claim); err != nil {
+					t.Fatal(err)
+				}
+				f.setCondition(claim, conditionRegistered)
+				f.setCondition(claim, conditionLaunched)
+			}
+			if err := f.c.Update(f.ctx, wl); err != nil {
+				t.Fatal(err)
+			}
+			f.reconcile()
+			matching := name == "matching registered claim"
+			if got := f.check().State; (got == kueue.CheckStateReady) != matching {
+				t.Fatalf("check=%s, matching=%t", got, matching)
+			}
+			if matching {
+				claims := f.claims()
+				if len(claims) != 2 {
+					t.Fatalf("got %d claims after adoption", len(claims))
+				}
+				for _, claim := range claims {
+					if !legacyNames[claim.GetName()] {
+						t.Errorf("created replacement %s", claim.GetName())
+					}
+				}
+			}
+		})
+	}
+}
