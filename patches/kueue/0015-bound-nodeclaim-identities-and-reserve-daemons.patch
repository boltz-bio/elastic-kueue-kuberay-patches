+func TestDaemonSetConstraintIntersection(t *testing.T) {
+	for name, tc := range map[string]struct {
+		requirements []corev1.NodeSelectorRequirement
+		want         bool
+	}{
+		"numeric interval": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "size", Operator: corev1.NodeSelectorOpGt, Values: []string{"4"}}, {Key: "size", Operator: corev1.NodeSelectorOpLt, Values: []string{"8"}},
+		}, want: true},
+		"numeric contradiction": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "size", Operator: corev1.NodeSelectorOpGt, Values: []string{"8"}}, {Key: "size", Operator: corev1.NodeSelectorOpLt, Values: []string{"8"}},
+		}},
+		"numeric allowed values": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "size", Operator: corev1.NodeSelectorOpIn, Values: []string{"4", "8"}}, {Key: "size", Operator: corev1.NodeSelectorOpGt, Values: []string{"4"}},
+		}, want: true},
+		"excluded allowed values": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "arch", Operator: corev1.NodeSelectorOpIn, Values: []string{"amd64"}}, {Key: "arch", Operator: corev1.NodeSelectorOpNotIn, Values: []string{"amd64"}},
+		}},
+		"presence contradiction": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "gpu", Operator: corev1.NodeSelectorOpExists}, {Key: "gpu", Operator: corev1.NodeSelectorOpDoesNotExist},
+		}},
+		"absence permitted": {requirements: []corev1.NodeSelectorRequirement{{Key: "gpu", Operator: corev1.NodeSelectorOpDoesNotExist}}, want: true},
+		"canonical numeric spelling excluded": {requirements: []corev1.NodeSelectorRequirement{
+			{Key: "size", Operator: corev1.NodeSelectorOpGt, Values: []string{"4"}}, {Key: "size", Operator: corev1.NodeSelectorOpLt, Values: []string{"6"}},
+			{Key: "size", Operator: corev1.NodeSelectorOpNotIn, Values: []string{"5"}},
+		}, want: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			got, err := selectorRequirementsCompatible(tc.requirements)
+			if err != nil || got != tc.want {
+				t.Fatalf("compatible = %v, %v; want %v", got, err, tc.want)
+			}
+		})
+	}
+	if _, err := selectorRequirementsCompatible([]corev1.NodeSelectorRequirement{{Key: "gpu", Operator: "unknown"}}); err == nil {
+		t.Fatal("invalid operator accepted")
+	}
+}
+
+func TestDaemonSetFieldConstraints(t *testing.T) {
+	name := strings.Repeat("node", 20) + ".example.com"
+	requirements := []corev1.NodeSelectorRequirement{{Key: "metadata.name", Operator: corev1.NodeSelectorOpIn, Values: []string{name}}}
+	got, err := daemonSetFieldsCompatible(requirements)
+	if err != nil || !got {
+		t.Fatalf("valid long node name: compatible = %v, error = %v", got, err)
+	}
+	requirements = append(requirements, corev1.NodeSelectorRequirement{Key: "metadata.name", Operator: corev1.NodeSelectorOpNotIn, Values: []string{name}})
+	got, err = daemonSetFieldsCompatible(requirements)
+	if err != nil || got {
+		t.Fatalf("contradictory node names: compatible = %v, error = %v", got, err)
+	}
+	got, err = daemonSetFieldsCompatible(requirements[1:])
+	if err != nil || !got {
+		t.Fatalf("future node name: compatible = %v, error = %v", got, err)
+	}
+}
+
+type overheadFailingReader struct {
+	client.Reader
+	failPods bool
+}
+
+func (r overheadFailingReader) List(ctx context.Context, list client.ObjectList, options ...client.ListOption) error {
+	_, pods := list.(*corev1.PodList)
+	if pods == r.failPods {
+		return errors.New("public API unavailable")
+	}
+	return r.Reader.List(ctx, list, options...)
+}
+
+func TestDaemonSetOverheadReadFailure(t *testing.T) {
+	for _, failPods := range []bool{false, true} {
+		c := &Controller{APIReader: overheadFailingReader{Reader: utiltesting.NewClientBuilder().WithObjects(overheadDaemonSet("agent")).Build(), failPods: failPods}}
+		got, err := c.daemonSetOverhead(t.Context(), &nodeClaimTemplate{})
+		if err == nil || got != nil {
+			t.Fatalf("API failure returned requests %v, error %v", got, err)
+		}
+	}
+}
