+			Tolerations: []corev1.Toleration{{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists}},
+		}}},
+	}
+}
+
+func TestNodeClaimIncludesWorkerAndDaemonSetResources(t *testing.T) {
+	ps := utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).
+		Request(corev1.ResourceCPU, "3").Request(corev1.ResourceMemory, "12Gi").Request("nvidia.com/gpu", "1").Obj()
+	f := newFixture(t, podSetWorkload(ps), nil, controllerOverheadDaemonSet("500m", "5Gi"))
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 1 {
+		t.Fatalf("got %d claims, want 1", len(claims))
+	}
+	want := map[string]string{"cpu": "3500m", "memory": "17Gi", "nvidia.com/gpu": "1", "pods": "2"}
+	if diff := cmp.Diff(want, requests(t, claims[0])); diff != "" {
+		t.Fatalf("claim requests (-want +got):\n%s", diff)
+	}
+	actual := resource.MustParse(requests(t, claims[0])["memory"])
+	if actual.Cmp(resource.MustParse("14Gi")) <= 0 {
+		t.Error("claim still fits the undersized candidate")
+	}
+	if got := ps.Template.Spec.Containers[0].Resources.Requests.Memory().String(); got != "12Gi" {
+		t.Errorf("worker memory changed to %s", got)
+	}
+}
+
+func TestPacksWorkersAfterReservingDaemonSetResources(t *testing.T) {
+	ps := utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 5).
+		Request(corev1.ResourceCPU, "2").Request(corev1.ResourceMemory, "4Gi").Obj()
+	f := newFixture(t, podSetWorkload(ps), nil, controllerOverheadDaemonSet("2", "5Gi"))
+	f.setPoolField([]any{
+		map[string]any{"key": "karpenter.k8s.aws/instance-cpu", "operator": "In", "values": []any{"16"}},
+		map[string]any{"key": "karpenter.k8s.aws/instance-memory", "operator": "In", "values": []any{"65536"}},
+	}, "spec", "template", "spec", "requirements")
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("got %d claims, want 2", len(claims))
+	}
+	for i, want := range []map[string]string{
+		{"cpu": "8", "memory": "17Gi", "pods": "4"},
+		{"cpu": "6", "memory": "13Gi", "pods": "3"},
+	} {
+		if diff := cmp.Diff(want, requests(t, claims[i])); diff != "" {
+			t.Errorf("claim %d requests (-want +got):\n%s", i, diff)
+		}
+	}
+}
diff --git a/pkg/controller/admissionchecks/karpenter/overhead.go b/pkg/controller/admissionchecks/karpenter/overhead.go
new file mode 100644
index 0000000..021bc85
--- /dev/null
+++ b/pkg/controller/admissionchecks/karpenter/overhead.go
@@ -0,0 +1,303 @@
+// Size reserved NodeClaims for the DaemonSets that can share each node. Use admitted Pod requests while preserving the DaemonSet's placement constraints.
+package karpenter
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"strconv"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/selection"
+	"k8s.io/component-helpers/scheduling/corev1/nodeaffinity"
+	"k8s.io/klog/v2"
+
+	"sigs.k8s.io/kueue/pkg/resources"
+)
+
+// +kubebuilder:rbac:groups="apps",resources=daemonsets,verbs=get;list
+
+// daemonSetOverhead returns one effective request, including a Pod slot, per compatible DaemonSet.
+func (c *Controller) daemonSetOverhead(ctx context.Context, tmpl *nodeClaimTemplate) (corev1.ResourceList, error) {
+	daemonSets := &appsv1.DaemonSetList{}
+	if err := c.APIReader.List(ctx, daemonSets); err != nil {
+		return nil, fmt.Errorf("listing DaemonSets for NodeClaim overhead: %w", err)
+	}
+	requests := corev1.ResourceList{}
+	if len(daemonSets.Items) == 0 {
+		return requests, nil
+	}
+	pods := &corev1.PodList{}
+	if err := c.APIReader.List(ctx, pods); err != nil {
+		return nil, fmt.Errorf("listing admitted DaemonSet Pods for NodeClaim overhead: %w", err)
+	}
+	for i := range daemonSets.Items {
+		ds := &daemonSets.Items[i]
+		if ds.DeletionTimestamp != nil {
+			continue
+		}
+		daemonRequests := corev1.ResourceList{}
+		compatible := false
+		for _, pod := range daemonSetPods(ds, pods.Items) {
+			fits, err := daemonSetCompatible(tmpl, pod)
+			if err != nil {
+				return nil, fmt.Errorf("checking DaemonSet %s/%s for NodeClaim overhead: %w", ds.Namespace, ds.Name, err)
+			}
+			if !fits {
+				continue
+			}
+			compatible = true
+			// Replicas can have different admission/VPA requests during a rollout. Reserve their per-resource maximum once.
+			for name, quantity := range resources.PodRequests(&pod.Spec) {
+				if current := daemonRequests[name]; quantity.Cmp(current) > 0 {
+					daemonRequests[name] = quantity.DeepCopy()
+				}
+			}
+		}
+		if !compatible {
+			continue
+		}
+		for name, quantity := range daemonRequests {
+			total := requests[name]
+			total.Add(quantity)
+			requests[name] = total
+		}
+		count := requests[corev1.ResourcePods]
+		count.Add(resource.MustParse("1"))
+		requests[corev1.ResourcePods] = count
+	}
+	return requests, nil
+}
+
+// daemonSetPods preserves admission mutations without inheriting the controller's node-specific affinity.
+func daemonSetPods(ds *appsv1.DaemonSet, pods []corev1.Pod) []*corev1.Pod {
+	// The current template can request more than old replicas while its rollout is starting.
+	representatives := []*corev1.Pod{daemonSetSchedulingPod(ds, &corev1.Pod{Spec: *ds.Spec.Template.Spec.DeepCopy()})}
+	for i := range pods {
+		pod := &pods[i]
+		if pod.Namespace == ds.Namespace && metav1.IsControlledBy(pod, ds) &&
+			pod.Status.Phase != corev1.PodSucceeded && pod.Status.Phase != corev1.PodFailed && pod.DeletionTimestamp == nil {
+			representatives = append(representatives, daemonSetSchedulingPod(ds, pod))
+		}
+	}
+	return representatives
+}
+
+func daemonSetSchedulingPod(ds *appsv1.DaemonSet, admitted *corev1.Pod) *corev1.Pod {
+	pod := admitted.DeepCopy()
+	// The DaemonSet controller replaces required affinity with the selected node's name.
+	if pod.Spec.Affinity != nil && pod.Spec.Affinity.NodeAffinity != nil {
+		pod.Spec.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution = nil
+	}
+	if affinity := ds.Spec.Template.Spec.Affinity; affinity != nil && affinity.NodeAffinity != nil &&
+		affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution != nil {
+		if pod.Spec.Affinity == nil {
+			pod.Spec.Affinity = &corev1.Affinity{}
+		}
+		if pod.Spec.Affinity.NodeAffinity == nil {
+			pod.Spec.Affinity.NodeAffinity = &corev1.NodeAffinity{}
+		}
+		pod.Spec.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution =
+			affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.DeepCopy()
+	}
+	// Kubernetes adds these tolerations when creating DaemonSet Pods, including when no replica exists yet.
+	for _, key := range []string{corev1.TaintNodeNotReady, corev1.TaintNodeUnreachable} {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: key, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoExecute})
+	}
+	for _, key := range []string{corev1.TaintNodeDiskPressure, corev1.TaintNodeMemoryPressure, corev1.TaintNodePIDPressure, corev1.TaintNodeUnschedulable} {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: key, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule})
+	}
+	if pod.Spec.HostNetwork {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: corev1.TaintNodeNetworkUnavailable, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule})
+	}
+	return pod
+}
+
+func daemonSetCompatible(tmpl *nodeClaimTemplate, pod *corev1.Pod) (bool, error) {
+	if raw, ok := tmpl.spec["taints"]; ok {
+		taints := struct {
+			Taints []corev1.Taint `json:"taints"`
+		}{}
+		if err := runtime.DefaultUnstructuredConverter.FromUnstructured(map[string]any{"taints": raw}, &taints); err != nil {
+			return false, fmt.Errorf("decoding NodePool taints: %w", err)
+		}
+		for _, taint := range taints.Taints {
+			if taint.Key == AntiTheftTaintKey || (taint.Effect != corev1.TaintEffectNoSchedule && taint.Effect != corev1.TaintEffectNoExecute) {
+				continue
+			}
+			tolerated := false
+			for _, toleration := range pod.Spec.Tolerations {
+				tolerated = tolerated || toleration.ToleratesTaint(klog.Background(), &taint, true)
+			}
+			if !tolerated {
+				return false, nil
+			}
+		}
+	}
+	base := []corev1.NodeSelectorRequirement{}
+	for _, raw := range tmpl.requirements {
+		object, ok := raw.(map[string]any)
+		if !ok {
+			return false, fmt.Errorf("invalid NodeClaim requirement %T", raw)
+		}
+		req := corev1.NodeSelectorRequirement{}
+		if err := runtime.DefaultUnstructuredConverter.FromUnstructured(object, &req); err != nil {
+			return false, fmt.Errorf("decoding NodeClaim requirement: %w", err)
+		}
+		base = append(base, req)
+	}
+	for key, value := range tmpl.labels {
+		base = append(base, corev1.NodeSelectorRequirement{Key: key, Operator: corev1.NodeSelectorOpIn, Values: []string{value}})
+	}
+	for key, value := range pod.Spec.NodeSelector {
+		base = append(base, corev1.NodeSelectorRequirement{Key: key, Operator: corev1.NodeSelectorOpIn, Values: []string{value}})
+	}
+	if affinity := pod.Spec.Affinity; affinity != nil && affinity.NodeAffinity != nil &&
+		affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution != nil {
+		for _, term := range affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms {
+			if len(term.MatchExpressions) == 0 && len(term.MatchFields) == 0 {
+				continue
+			}
+			compatible, err := selectorRequirementsCompatible(append(append([]corev1.NodeSelectorRequirement{}, base...), term.MatchExpressions...))
+			if err != nil {
+				return false, err
+			}
+			fieldsCompatible, err := daemonSetFieldsCompatible(term.MatchFields)
+			if err != nil {
+				return false, err
+			}
+			if compatible && fieldsCompatible {
+				return true, nil
+			}
+		}
+		return false, nil
+	}
+	return selectorRequirementsCompatible(base)
+}
+
+func daemonSetFieldsCompatible(requirements []corev1.NodeSelectorRequirement) (bool, error) {
+	if len(requirements) == 0 {
+		return true, nil
+	}
+	selector, err := nodeaffinity.NewNodeSelector(&corev1.NodeSelector{NodeSelectorTerms: []corev1.NodeSelectorTerm{{MatchFields: requirements}}})
+	if err != nil {
+		return false, err
+	}
+	var names []string
+	for _, req := range requirements {
+		if req.Key == "metadata.name" && req.Operator == corev1.NodeSelectorOpIn {
+			names = req.Values
+			break
+		}
+	}
+	if names == nil {
+		// Without an exact name, one more candidate than exclusions guarantees a possible future node name.
+		for i := 0; i <= len(requirements); i++ {
+			names = append(names, "daemon-node-"+strconv.Itoa(i))
+		}
+	}
+	for _, name := range names {
+		if selector.Match(&corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: name}}) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// selectorRequirementsCompatible checks intersections without mistaking unknown future labels for absent labels.
+func selectorRequirementsCompatible(requirements []corev1.NodeSelectorRequirement) (bool, error) {
+	groups := map[string][]*labels.Requirement{}
+	for _, req := range requirements {
+		operators := map[corev1.NodeSelectorOperator]selection.Operator{
+			corev1.NodeSelectorOpIn: selection.In, corev1.NodeSelectorOpNotIn: selection.NotIn,
+			corev1.NodeSelectorOpExists: selection.Exists, corev1.NodeSelectorOpDoesNotExist: selection.DoesNotExist,
+			corev1.NodeSelectorOpGt: selection.GreaterThan, corev1.NodeSelectorOpLt: selection.LessThan,
+		}
+		op, ok := operators[req.Operator]
+		if !ok {
+			return false, fmt.Errorf("unsupported selector operator %q", req.Operator)
+		}
+		parsed, err := labels.NewRequirement(req.Key, op, req.Values)
+		if err != nil {
+			return false, err
+		}
+		groups[req.Key] = append(groups[req.Key], parsed)
+	}
+	for key, group := range groups {
+		matches := func(values labels.Set) bool {
+			for _, req := range group {
+				if !req.Matches(values) {
+					return false
+				}
+			}
+			return true
+		}
+		if matches(labels.Set{}) {
+			continue
+		}
+		var candidates []string
+		bounded := false
+		lower, upper := int64(0), int64(math.MaxInt64)
+		valuesCount := 0
+		for _, req := range group {
+			values := req.Values().List()
+			valuesCount += len(values)
+			if req.Operator() == selection.In {
+				candidates, bounded = values, true
+				break
+			}
+		}
+		if !bounded {
+			numeric := false
+			for _, req := range group {
+				if req.Operator() != selection.GreaterThan && req.Operator() != selection.LessThan {
+					continue
+				}
+				numeric = true
+				n, _ := strconv.ParseInt(req.Values().List()[0], 10, 64)
+				if req.Operator() == selection.GreaterThan {
+					if n == math.MaxInt64 {
+						return false, nil
+					}
+					lower = max(lower, n+1)
+				} else {
+					upper = min(upper, n-1)
+				}
+			}
+			if numeric {
+				for n, tried := lower, 0; n <= upper && tried <= valuesCount; tried++ {
+					value := strconv.FormatInt(n, 10)
+					// Leading zeros are valid label values, including when a narrow numeric range excludes the canonical spelling.
+					for len(value) <= 63 {
+						candidates = append(candidates, value)
+						value = "0" + value
+					}
+					if n == math.MaxInt64 {
+						break
+					}
+					n++
+				}
+			} else {
+				for i := 0; i <= valuesCount; i++ {
+					candidates = append(candidates, "daemon-"+strconv.Itoa(i))
+				}
+			}
+		}
+		found := false
+		for _, value := range candidates {
+			if matches(labels.Set{key: value}) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false, nil
+		}
+	}
+	return true, nil
+}
diff --git a/pkg/controller/admissionchecks/karpenter/overhead_test.go b/pkg/controller/admissionchecks/karpenter/overhead_test.go
new file mode 100644
index 0000000..22841af
--- /dev/null
+++ b/pkg/controller/admissionchecks/karpenter/overhead_test.go
@@ -0,0 +1,268 @@
+// Verify per-node DaemonSet budgets from public API objects, including admission mutations, placement constraints, and request aggregation.
+package karpenter
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+)
+
+func overheadDaemonSet(name string) *appsv1.DaemonSet {
+	return &appsv1.DaemonSet{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "system", UID: types.UID(name)},
+		Spec: appsv1.DaemonSetSpec{Template: corev1.PodTemplateSpec{Spec: corev1.PodSpec{
+			Containers: []corev1.Container{{Name: "agent", Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
+				corev1.ResourceCPU: resource.MustParse("100m"), corev1.ResourceMemory: resource.MustParse("1Gi"),
+			}}}},
+		}}},
+	}
+}
+
+func overheadPod(ds *appsv1.DaemonSet, name, cpu, memory string) *corev1.Pod {
+	return &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: ds.Namespace, UID: types.UID(name), OwnerReferences: []metav1.OwnerReference{{
+			APIVersion: "apps/v1", Kind: "DaemonSet", Name: ds.Name, UID: ds.UID, Controller: new(true),
+		}}},
+		Spec: corev1.PodSpec{Containers: []corev1.Container{{Name: "agent", Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse(cpu), corev1.ResourceMemory: resource.MustParse(memory),
+		}}}}},
+	}
+}
+
+func assertOverhead(t *testing.T, got corev1.ResourceList, want map[corev1.ResourceName]string) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("resources = %v, want %v", got, want)
+	}
+	for name, text := range want {
+		quantity := got[name]
+		if quantity.Cmp(resource.MustParse(text)) != 0 {
+			t.Errorf("%s = %s, want %s", name, quantity.String(), text)
+		}
+	}
+}
+
+func TestDaemonSetOverheadAdmittedReplicas(t *testing.T) {
+	ds := overheadDaemonSet("agent")
+	ds.Spec.Template.Spec.Affinity = &corev1.Affinity{NodeAffinity: &corev1.NodeAffinity{
+		RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{NodeSelectorTerms: []corev1.NodeSelectorTerm{{
+			MatchExpressions: []corev1.NodeSelectorRequirement{{Key: corev1.LabelArchStable, Operator: corev1.NodeSelectorOpIn, Values: []string{"amd64"}}},
+		}}},
+	}}
+	pod := overheadPod(ds, "replica-a", "400m", "2Gi")
+	pod.Spec.Affinity = &corev1.Affinity{NodeAffinity: &corev1.NodeAffinity{
+		RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{NodeSelectorTerms: []corev1.NodeSelectorTerm{{
+			MatchFields: []corev1.NodeSelectorRequirement{{Key: "metadata.name", Operator: corev1.NodeSelectorOpIn, Values: []string{"existing-node"}}},
+		}}},
+	}}
+	other := overheadPod(ds, "replica-b", "200m", "3Gi")
+	wrongOwner := overheadPod(ds, "old-daemonset-uid", "8", "64Gi")
+	wrongOwner.OwnerReferences[0].UID = "replaced-daemonset"
+	terminal := overheadPod(ds, "terminal", "8", "64Gi")
+	terminal.Status.Phase = corev1.PodSucceeded
+	client := utiltesting.NewClientBuilder().WithObjects(ds, pod, other, wrongOwner, terminal).Build()
+	c := &Controller{APIReader: client}
+	tmpl := &nodeClaimTemplate{requirements: []any{requirement(corev1.LabelArchStable, "amd64")}}
+	got, err := c.daemonSetOverhead(t.Context(), tmpl)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertOverhead(t, got, map[corev1.ResourceName]string{corev1.ResourceCPU: "400m", corev1.ResourceMemory: "3Gi", corev1.ResourcePods: "1"})
+	// The admitted resource changes survive; affinity comes from the template and both inputs stay intact.
+	beforeDS, beforePod := ds.DeepCopy(), pod.DeepCopy()
+	representatives := daemonSetPods(ds, []corev1.Pod{*pod})
+	if len(representatives) != 2 || !reflect.DeepEqual(representatives[1].Spec.Affinity, ds.Spec.Template.Spec.Affinity) {
+		t.Fatalf("required affinity = %v, want DaemonSet template affinity", representatives)
+	}
+	if !reflect.DeepEqual(ds, beforeDS) || !reflect.DeepEqual(pod, beforePod) {
+		t.Fatal("DaemonSet or admitted Pod mutated")
+	}
+	// Template affinity must also exclude this same live Pod from an ARM node.
+	got, err = c.daemonSetOverhead(t.Context(), &nodeClaimTemplate{requirements: []any{requirement(corev1.LabelArchStable, "arm64")}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertOverhead(t, got, map[corev1.ResourceName]string{})
+	// A new template request must be reserved before the first updated replica exists.
+	ds.Spec.Template.Spec.Containers[0].Resources.Requests[corev1.ResourceMemory] = resource.MustParse("5Gi")
+	c = &Controller{APIReader: utiltesting.NewClientBuilder().WithObjects(ds, pod, other).Build()}
+	got, err = c.daemonSetOverhead(t.Context(), tmpl)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertOverhead(t, got, map[corev1.ResourceName]string{corev1.ResourceCPU: "400m", corev1.ResourceMemory: "5Gi", corev1.ResourcePods: "1"})
+}
+
+func TestDaemonSetOverheadResourceSemantics(t *testing.T) {
+	ds := overheadDaemonSet("agent")
+	ds.Spec.Template.Spec.InitContainers = []corev1.Container{
+		{Name: "sidecar", RestartPolicy: new(corev1.ContainerRestartPolicyAlways), Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("50m"), corev1.ResourceMemory: resource.MustParse("128Mi"),
+		}}},
+		{Name: "init", Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
+			corev1.ResourceCPU: resource.MustParse("500m"), corev1.ResourceMemory: resource.MustParse("4Gi"),
+		}}},
+	}
+	ds.Spec.Template.Spec.Overhead = corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("25m"), corev1.ResourceMemory: resource.MustParse("64Mi")}
+	other := overheadDaemonSet("other")
+	c := &Controller{APIReader: utiltesting.NewClientBuilder().WithObjects(ds, other).Build()}
+	got, err := c.daemonSetOverhead(t.Context(), &nodeClaimTemplate{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertOverhead(t, got, map[corev1.ResourceName]string{corev1.ResourceCPU: "675m", corev1.ResourceMemory: "5312Mi", corev1.ResourcePods: "2"})
+}
+
+func TestDaemonSetOverheadDeletingDaemonSet(t *testing.T) {
+	ds := overheadDaemonSet("agent")
+	now := metav1.Now()
+	ds.DeletionTimestamp = &now
+	ds.Finalizers = []string{"cleanup"}
+	c := &Controller{APIReader: utiltesting.NewClientBuilder().WithObjects(ds).Build()}
+	got, err := c.daemonSetOverhead(t.Context(), &nodeClaimTemplate{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertOverhead(t, got, map[corev1.ResourceName]string{})
+}
+
+func TestDaemonSetOverheadPlacement(t *testing.T) {
+	for name, tc := range map[string]struct {
+		selector     map[string]string
+		affinity     []corev1.NodeSelectorTerm
+		requirements []any
+		labels       map[string]string
+		taints       []any
+		tolerations  []corev1.Toleration
+		want         bool
+	}{
+		"matching architecture":     {selector: map[string]string{corev1.LabelArchStable: "amd64"}, requirements: []any{requirement(corev1.LabelArchStable, "amd64")}, want: true},
+		"incompatible architecture": {selector: map[string]string{corev1.LabelArchStable: "arm64"}, requirements: []any{requirement(corev1.LabelArchStable, "amd64")}},
+		"future GPU label":          {selector: map[string]string{"nvidia.com/gpu.present": "true"}, want: true},
+		"template label":            {selector: map[string]string{"team": "ml"}, labels: map[string]string{"team": "other"}},
+		"affinity OR": {requirements: []any{requirement(corev1.LabelArchStable, "amd64")}, affinity: []corev1.NodeSelectorTerm{
+			{MatchExpressions: []corev1.NodeSelectorRequirement{{Key: corev1.LabelArchStable, Operator: corev1.NodeSelectorOpIn, Values: []string{"arm64"}}}},
+			{MatchExpressions: []corev1.NodeSelectorRequirement{{Key: corev1.LabelArchStable, Operator: corev1.NodeSelectorOpNotIn, Values: []string{"arm64"}}}},
+		}, want: true},
+		"empty required affinity":       {affinity: []corev1.NodeSelectorTerm{}},
+		"empty affinity term":           {affinity: []corev1.NodeSelectorTerm{{}}},
+		"untolerated permanent taint":   {taints: []any{map[string]any{"key": "nvidia.com/gpu", "effect": "NoSchedule"}}},
+		"permanent taint tolerated":     {taints: []any{map[string]any{"key": "nvidia.com/gpu", "effect": "NoSchedule"}}, tolerations: []corev1.Toleration{{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists}}, want: true},
+		"reservation taint":             {taints: []any{map[string]any{"key": AntiTheftTaintKey, "effect": "NoSchedule"}}, want: true},
+		"preference taint":              {taints: []any{map[string]any{"key": "preference", "effect": "PreferNoSchedule"}}, want: true},
+		"automatic pressure toleration": {taints: []any{map[string]any{"key": corev1.TaintNodeMemoryPressure, "effect": "NoSchedule"}}, want: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ds := overheadDaemonSet("agent")
+			ds.Spec.Template.Spec.NodeSelector = tc.selector
+			ds.Spec.Template.Spec.Tolerations = tc.tolerations
+			if tc.affinity != nil {
+				ds.Spec.Template.Spec.Affinity = &corev1.Affinity{NodeAffinity: &corev1.NodeAffinity{RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{NodeSelectorTerms: tc.affinity}}}
+			}
+			tmpl := &nodeClaimTemplate{requirements: tc.requirements, labels: tc.labels, spec: map[string]any{
+				"taints":        tc.taints,
+				"startupTaints": []any{map[string]any{"key": "startup", "effect": "NoSchedule"}},
+			}}
+			c := &Controller{APIReader: utiltesting.NewClientBuilder().WithObjects(ds).Build()}
+			got, err := c.daemonSetOverhead(t.Context(), tmpl)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := map[corev1.ResourceName]string{}
+			if tc.want {
+				want = map[corev1.ResourceName]string{corev1.ResourceCPU: "100m", corev1.ResourceMemory: "1Gi", corev1.ResourcePods: "1"}
+			}
+			assertOverhead(t, got, want)
+		})
+	}
+}
