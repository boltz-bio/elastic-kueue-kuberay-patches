+// Preserve the identities and pod counts of immutable NodeClaims from an already provisioned reservation.
+package karpenter
+
+import (
+	"fmt"
+	"strconv"
+
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+// provisionedPodSetClaims retains immutable capacity across changes to placement, overhead, or packing.
+func provisionedPodSetClaims(
+	wl *kueue.Workload,
+	attempt string,
+	podSet kueue.PodSetReference,
+	count int32,
+	flavorLabels map[string]string,
+	existing []unstructured.Unstructured,
+) ([]*unstructured.Unstructured, string) {
+	labels := map[string]string{
+		ManagedLabelKey:           "kueue",
+		WorkloadNamespaceLabelKey: wl.Namespace,
+		WorkloadLabelKey:          wl.Name,
+		AttemptLabelKey:           attempt,
+		constants.PodSetLabel:     string(podSet),
+		NodePoolLabelKey:          flavorLabels[NodePoolLabelKey],
+	}
+	var claims []*unstructured.Unstructured
+	var pods int64
+	for i := range existing {
+		claim := &existing[i]
+		actual := claim.GetLabels()
+		if actual[AttemptLabelKey] != attempt || actual[constants.PodSetLabel] != string(podSet) {
+			continue
+		}
+		if !matchesNodeClaimLabels(actual, labels) {
+			return nil, fmt.Sprintf("NodeClaim %s has inconsistent provisioned ownership or NodePool", claim.GetName())
+		}
+		n, err := strconv.ParseInt(claim.GetAnnotations()[PodsAnnotation], 10, 32)
+		if err != nil || n <= 0 {
+			return nil, fmt.Sprintf("NodeClaim %s has an invalid provisioned pod count", claim.GetName())
+		}
+		pods += n
+		claims = append(claims, claim.DeepCopy())
+	}
+	if pods != int64(count) {
+		return nil, fmt.Sprintf("pod set %s has %d provisioned pods, expected %d", podSet, pods, count)
+	}
+	ordered := make([]*unstructured.Unstructured, len(claims))
+	for i := range ordered {
+		suffix := fmt.Sprintf("%s-%d", podSet, i)
+		for _, claim := range claims {
+			if claim.GetName() == nodeClaimName(wl, attempt, suffix) || claim.GetName() == legacyNodeClaimName(wl.Name, attempt, suffix) {
+				if ordered[i] != nil {
+					return nil, fmt.Sprintf("pod set %s has duplicate provisioned claim ordinal %d", podSet, i)
+				}
+				ordered[i] = claim
+			}
+		}
+		if ordered[i] == nil {
+			return nil, fmt.Sprintf("pod set %s is missing provisioned claim ordinal %d", podSet, i)
+		}
+	}
+	return ordered, ""
+}
