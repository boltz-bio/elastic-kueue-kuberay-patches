+func TestPlacementUpgradePreservesProvisionedShape(t *testing.T) {
+	ps := utiltestingapi.MakePodSet("workers", 4).Request(corev1.ResourceCPU, "1").Obj()
+	ps.Template.Spec.Affinity = mandatoryAffinity(placementTerm("karpenter.k8s.aws/instance-cpu", corev1.NodeSelectorOpLt, "5"))
+	wl := podSetWorkload(ps)
+	attempt := attemptID(wl, reservedAt)
+	wl.Annotations = map[string]string{ProvisionedAttemptAnnotation: attempt}
+	f := newFixture(t, wl, map[string]string{WaitForAnnotation: conditionRegistered})
+	f.setPoolField([]any{map[string]any{"key": "karpenter.k8s.aws/instance-cpu", "operator": "Lt", "values": []any{"9"}}}, "spec", "template", "spec", "requirements")
+	tmpl, problem, err := f.ctrl.nodeClaimTemplate(f.ctx, map[string]string{NodePoolLabelKey: "pool-a"}, config{})
+	if err != nil || problem != "" {
+		t.Fatalf("template = %v, %s", err, problem)
+	}
+	// The former controller packed four workers using the pool's upper bound, before projecting the Pod's tighter bound.
+	claim := tmpl.nodeClaim(wl, attempt, "workers-0", 4, resources.PodRequests(&ps.Template.Spec), nil)
+	labels := claim.GetLabels()
+	labels[constants.PodSetLabel] = "workers"
+	claim.SetLabels(labels)
+	if err := f.c.Create(f.ctx, claim); err != nil {
+		t.Fatal(err)
+	}
+	f.setCondition(claim, conditionRegistered)
+	wantSpec := runtime.DeepCopyJSONValue(claim.Object["spec"])
+	wantName := claim.GetName()
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 1 || claims[0].GetName() != wantName {
+		t.Fatalf("registered capacity replaced during upgrade: claims=%v check=%v", claims, f.check())
+	}
+	if diff := cmp.Diff(wantSpec, claims[0].Object["spec"]); diff != "" {
+		t.Errorf("immutable claim changed (-want +got):\n%s", diff)
+	}
+	if check := f.check(); check.State != kueue.CheckStateReady {
+		t.Errorf("check = %v, want preserved registered claim Ready", check)
+	}
+}
