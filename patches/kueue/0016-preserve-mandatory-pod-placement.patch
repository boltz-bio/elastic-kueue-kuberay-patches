+func TestNodeClaimsRejectImpossiblePodPlacement(t *testing.T) {
+	for name, tc := range map[string]struct {
+		selector map[string]string
+		affinity *corev1.Affinity
+		nodeName string
+		want     string
+	}{
+		"NodePool requirement conflict":      {selector: map[string]string{"karpenter.sh/capacity-type": "spot"}, want: "conflict"},
+		"NodePool metadata label conflict":   {selector: map[string]string{"team": "other"}, want: "conflict"},
+		"flavor conflict":                    {selector: map[string]string{NodePoolLabelKey: "other"}, want: "conflict"},
+		"all affinity branches incompatible": {selector: map[string]string{corev1.LabelArchStable: "amd64"}, affinity: mandatoryAffinity(placementTerm(corev1.LabelArchStable, corev1.NodeSelectorOpIn, "arm64")), want: "no required"},
+		"empty required affinity":            {affinity: mandatoryAffinity(), want: "no required"},
+		"empty required term":                {affinity: mandatoryAffinity(corev1.NodeSelectorTerm{}), want: "no required"},
+		"node fields unsupported":            {affinity: mandatoryAffinity(corev1.NodeSelectorTerm{MatchFields: []corev1.NodeSelectorRequirement{{Key: "metadata.name", Operator: corev1.NodeSelectorOpIn, Values: []string{"existing-node"}}}}), want: "node fields are unsupported"},
+		"nodeName unsupported":               {nodeName: "existing-node", want: "nodeName"},
+		"invalid operator":                   {affinity: mandatoryAffinity(placementTerm("gpu-class", "invalid", "l4")), want: "validating required"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ps := utiltestingapi.MakePodSet("workers", 1).Request(corev1.ResourceCPU, "1").Obj()
+			ps.Template.Spec.NodeSelector, ps.Template.Spec.Affinity, ps.Template.Spec.NodeName = tc.selector, tc.affinity, tc.nodeName
+			f := newFixture(t, podSetWorkload(ps), nil)
+			f.reconcile()
+			if len(f.claims()) != 0 {
+				t.Fatal("created claims despite impossible mandatory placement")
+			}
+			check := f.check()
+			if check.State != kueue.CheckStateRetry || !strings.Contains(check.Message, tc.want) {
